{
  "name": "@square360/cbey-js-widgets",
  "version": "0.1.0",
  "description": "Curated catalogue of framework-agnostic interactive widgets for the CBEY Drupal site. Each widget is a sealed shadow-DOM unit.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Square360/cbey-js-widgets.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/emit-manifest.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  }
}
